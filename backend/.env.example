# Study API — copy to `.env` locally (gitignored). Names only; never commit values.

# Durable storage (production uses Supabase Postgres via DATABASE_URL)
STORAGE_MODE=memory
DATABASE_URL=

# OpenAI text and Realtime (Railway only; never in Vercel or the browser)
OPENAI_API_KEY=

# Browser CORS allowlist (comma-separated origins; no *)
# Canonical name: PARTICIPANT_UI_ORIGINS. Runtime currently reads CORS_ALLOWED_ORIGINS.
PARTICIPANT_UI_ORIGINS=
CORS_ALLOWED_ORIGINS=

# Participant capability cookie signing
# Canonical name: PARTICIPANT_COOKIE_SECRET. Runtime currently reads CAPABILITY_SIGNING_SECRET.
PARTICIPANT_COOKIE_SECRET=
CAPABILITY_SIGNING_SECRET=

# Invitation token hashing pepper (production batches)
INVITATION_TOKEN_PEPPER=

# Internal worker auth (Study API + realtime worker)
INTERNAL_WORKER_TOKEN=

# Staff JWT verification (Supabase; Railway only)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Service role for /ready when STUDY_API_ROLE=api
STUDY_API_ROLE=api

# Deploy metadata (set by Railway)
RAILWAY_GIT_COMMIT_SHA=

# Tracing — keep false until a written retention policy is approved
TRACE_EXPORT_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=issue-discussion-local
LANGSMITH_WORKSPACE_ID=
